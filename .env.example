# TailorVoice environment settings. Copy to `.env` for local overrides.
# No secrets, no API keys — every value has a working local default (zero-cost rule).
# `.env` stays local and is never shared or uploaded.

# Rewriter backend: "template" (always works, deterministic) or "ollama" (local model).
REWRITER_BACKEND=template

# Local Ollama (only used when REWRITER_BACKEND=ollama). No key, text never leaves the machine.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Whisper model size for the ASR stage: base | small.
WHISPER_MODEL_SIZE=base

# Storage (local SQLite file).
DATABASE_URL=sqlite:///./tailorvoice.db

# Guards.
MAX_INPUT_CHARS=20000
RATE_LIMIT_PER_MIN=60

# CORS: only the local frontend origin is allowed.
FRONTEND_ORIGIN=http://localhost:5173
