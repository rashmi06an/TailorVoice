# NOTE: Claude Code never runs git here (spec rule 10). This file exists only so that if
# *you* later initialise version control yourself, private and generated files stay out.

# Privacy: real personal data never leaves the machine.
data/private/
*.resume
*.profile

# Local env + secrets
.env

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Models / caches / DB
*.db
models/
.cache/

# Node / frontend
frontend/node_modules/
frontend/dist/

# OS
.DS_Store
